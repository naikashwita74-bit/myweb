PORT=3000
DATABASE_PATH=database/expense-tracker.db

# GEMINI_API_KEY: API key for the AI Expense Analyzer (Google Gemini).
# Leave empty to run the analyzer with the built-in deterministic analysis.
GEMINI_API_KEY=""

# AI_MODEL: Gemini model used for the AI Expense Analyzer.
AI_MODEL=gemini-flash-latest

# AI_INCLUDE_DESCRIPTIONS: Set to "true" to send transaction descriptions to the
# AI provider. Keep it "false" to send only titles, categories, amounts and dates.
AI_INCLUDE_DESCRIPTIONS=false
